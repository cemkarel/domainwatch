{
  "name": "domainwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.13"},
  "scripts": {
    "build": "vite build",
    "dev": "npm run build && wrangler dev --test-scheduled",
    "deploy": "npm run build && npm run deploy:cloudflare",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "types": "wrangler types --env-interface WorkerBindings",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "scanner": "node scanner/server.mjs",
    "poc:tls": "wrangler dev --config poc/wrangler.jsonc --port 8788"
  },
  "dependencies": {
    "hono": "^4.11.0",
    "ipaddr.js": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tldts": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "wrangler": "^4.151.2"
  }
}
