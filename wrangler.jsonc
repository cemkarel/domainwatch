{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domainwatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "domainwatch",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }],
  "ratelimits": [
    {"name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": {"limit": 15, "period": 60}},
    {"name": "WRITE_LIMIT", "namespace_id": "1002", "simple": {"limit": 20, "period": 60}},
    {"name": "TEST_LIMIT", "namespace_id": "1003", "simple": {"limit": 2, "period": 60}}
  ],
  "triggers": {"crons": ["*/5 * * * *"]},
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
